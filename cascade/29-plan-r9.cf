PLAN P3<-F16 op=insert at=flight-sim3.html:16318#"function updateHUD(dt = 1 / 60) {" why=compass-ribbon-driver ref=flight-sim3.html:16337-16340#"let hdg = Math.atan2(fwd.x",flight-sim3.html:2#"nhud-compass-scale (mount from P2)" test="cd /Users/jkneen/Downloads/ships && node -e \"const s=require('fs').readFileSync('flight-sim3.html','utf8');new Function(s.slice(s.indexOf('function updateCompassHUD'),s.indexOf('function updateCompassHUD')+1400))\" (syntax ok); grep -c 'function updateCompassHUD' flight-sim3.html (expect 1); bun web (bg,:8765); PW load flight-sim3.html then eval __ap.setSpawnMode('sky');__ap.reset(); 0 console errors; compass ticks scroll with heading (V2/V4)" order=3 fill=-
<<<P3
// Compass ribbon — builds a degree scale once into #nhud-compass-scale, then
// each frame slides it by heading via transform translateX (cheap, no realloc).
let _nhudCompassBuilt = false;
const NHUD_PX_PER_DEG = 3.4;      // 320px view ≈ ±47° visible
const NHUD_CARDINALS = { 0:'N', 90:'E', 180:'S', 270:'W' };
function nhudBuildCompass() {
  const scale = document.getElementById('nhud-compass-scale');
  if (!scale) return false;
  let html = '';
  // Overscan -60..420 so the visible window never runs off the strip near N.
  for (let d = -60; d <= 420; d += 5) {
    const deg = ((d % 360) + 360) % 360;
    const x = (d + 60) * NHUD_PX_PER_DEG;           // strip-local px (0-based)
    const card = NHUD_CARDINALS[deg];
    const label = card || (deg % 30 === 0 ? String(deg) : '');
    html += `<div class="nhud-tick${card ? ' card' : ''}" style="left:${x}px"><u></u><s>${label}</s></div>`;
  }
  scale.innerHTML = html;
  scale.style.width = (480 * NHUD_PX_PER_DEG) + 'px';
  _nhudCompassBuilt = true;
  return true;
}
let _nhudCompassLast = -1;
function updateCompassHUD(hdg) {
  if (!_nhudCompassBuilt && !nhudBuildCompass()) return;
  const r = Math.round(hdg);
  if (r === _nhudCompassLast) return;
  _nhudCompassLast = r;
  const scale = document.getElementById('nhud-compass-scale');
  if (!scale) return;
  // Center the current heading under the caret (view center = 160px).
  const offset = 160 - (hdg + 60) * NHUD_PX_PER_DEG;
  scale.style.transform = `translateX(${offset.toFixed(1)}px)`;
}
>>>
PLAN P4<-F16 op=replace at=flight-sim3.html:15006-15012#"const tag = document.createElement('div');" why=kill-floating-tags-add-contacts-panel ref=flight-sim3.html:14998-15016#"function ensureTargetHudPool()",flight-sim3.html:15568-15587#"const tagText = isActive",flight-sim3.html:17932#"const traffic = []",flight-sim3.html:18082-18104#"const rec = {",flight-sim3.html:14989-14996#"function inferTargetTypeLabel" test="cd /Users/jkneen/Downloads/ships && grep -c 'poolEntry.tag.textContent\|poolEntry.readout.textContent' flight-sim3.html (expect 0 — floating text writes removed); grep -c 'function updateContactsHUD\|id=\"nhud-contacts\"' flight-sim3.html (expect 2); bun web (bg,:8765); PW load flight-sim3.html; eval __ap.setSpawnMode('sky');__ap.reset(); 0 console errors; in-world diamond brackets still present, no floating text tags in sky, contacts panel lists traffic (V2/V4)" order=4 fill=S
