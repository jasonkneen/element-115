PLAN P3<-F2 op=replace at=flight-sim3.html:3047#"vec3 diffuse = vColor" why=terrain-macro-noise ref=flight-sim3.html:2999-3013#"float hash21",flight-sim3.html:3017#"vec2 uv = vWorldPos.xz",flight-sim3.html:3034#"float flatness = smoothstep" test="bun web; Playwright open http://localhost:8765/flight-sim3.html; V2 console clean (SAND_FS compiles); V4 noon screenshot — terrain shows low/mid-freq patchiness at 100-800m, cliff strata unchanged" order=3 fill=-
<<<P3
    // ---- Macro albedo patchiness (2-octave value noise) ----
    // Low-freq basins + mid-freq mottling break the flat single-colour read at
    // 100-800m; gated by flatness so cliff faces keep their strata colours.
    float m1 = vnoise(uv * 0.004);
    float m2 = vnoise(uv * 0.018);
    float macro = (m1 - 0.5) * 0.10 + (m2 - 0.5) * 0.06;
    vec3 hue = mix(vec3(1.0), vec3(1.05, 1.0, 0.95), m1);
    vec3 albedo = vColor * (1.0 + macro * flatness) * mix(vec3(1.0), hue, flatness);
    vec3 diffuse = albedo * (NdotL * sunColor + hemiCol * 0.45 + ambientColor);
>>>
