PLAN P5<-F17 op=replace at=flight-sim3.html:5137-5144#"// Canopy — stretched half-sphere" why=teardrop-canopy-plus-frame ref=flight-sim3.html:5314-5369#"COCKPIT INTERIOR",flight-sim3.html:5740#"root.userData.cockpitGlow" test="cd /Users/jkneen/Downloads/ships && grep -c 'LatheGeometry' flight-sim3.html (>=1); bun web (bg,:8765); PW load /flight-sim3.html; 0 errors; V4 dusk — teardrop bubble canopy with dark frame rails, cockpit still visible through glass (V2/V4). matCanopy still referenced by cockpitGlow @5740 (unchanged)." order=5 fill=-
<<<P5
  // Canopy — teardrop bubble via lathe profile (windscreen rake -> apex ->
  // spine fairing), thin dark frame rails, envMap glass (matCanopy set in P3).
  const canopyProfile = [
    new THREE.Vector2(0.00, 0.00),   // windscreen base tip (forward)
    new THREE.Vector2(0.34, 0.28),
    new THREE.Vector2(0.60, 0.95),   // bubble max
    new THREE.Vector2(0.58, 1.70),
    new THREE.Vector2(0.40, 2.55),
    new THREE.Vector2(0.17, 3.35),   // spine fairing taper
    new THREE.Vector2(0.00, 3.90),   // tail point
  ];
  const canopy = new THREE.Mesh(
    new THREE.LatheGeometry(canopyProfile, 20),
    matCanopy
  );
  // Lathe axis is +Y (length 0..3.9). Rotate axis to plane-forward (-Z) and
  // seat over the cockpit: nose end near z=-2.7, tail near z=+1.2.
  canopy.rotation.x = -Math.PI / 2;
  canopy.scale.set(1.05, 1.0, 1.0);        // slightly wider than tall
  canopy.position.set(0, 0.62, -2.7);
  root.add(canopy);
  // Frame rails — thin dark arcs (windscreen bow + mid hoop)
  const canopyFrameMat = matDark;
  const wsBow = new THREE.Mesh(
    new THREE.TorusGeometry(0.42, 0.03, 6, 16, Math.PI),
    canopyFrameMat
  );
  wsBow.rotation.y = Math.PI / 2;
  wsBow.position.set(0, 0.55, -2.35);
  root.add(wsBow);
  const midHoop = new THREE.Mesh(
    new THREE.TorusGeometry(0.5, 0.028, 6, 16, Math.PI),
    canopyFrameMat
  );
  midHoop.rotation.y = Math.PI / 2;
  midHoop.position.set(0, 0.52, -0.7);
  root.add(midHoop);
>>>
PLAN P6<-F18 op=replace at=flight-sim3.html:5146-5177#"// --- Wings: swept delta" why=airfoil-wings-plus-lerx ref=flight-sim3.html:5088-5117#"function addWingGun",flight-sim3.html:5749-5750#"root.userData.wingtipL" test="cd /Users/jkneen/Downloads/ships && grep -c 'airfoilSurface({' flight-sim3.html (>=1); bun web (bg,:8765); PW load /flight-sim3.html; 0 errors; V4 noon — cambered swept wings with LERX strakes, two-tone top/belly, NOT inside-out. Guns @4.55 / rails @4.15 still on the wing surface (V2/V4)." order=6 fill=-
<<<P6
  // --- Wings: airfoil loft (rounded LE, cambered upper, sharp TE), swept delta
  // with LERX strakes. Span/sweep/dihedral preserved from the old slab so the
  // gun (x=+/-4.55), rail/missile (x=+/-4.15) and wingtip FX anchors stay valid. ---
  const wingMat = new THREE.MeshStandardMaterial({
    vertexColors: true, metalness: 0.55, roughness: 0.5
  });
  wingMat.envMap = jetEnvCube; wingMat.envMapIntensity = 0.5;
  const wingGeoR = airfoilSurface({
    span: 5.4, rootChord: 3.4, tipChord: 1.35, sweep: 2.05,
    dihedral: 0.22, thick: 0.10, camber: 0.015, cTop: 0x5a626d, cBot: 0x8a96a8
  });
  const wingR = new THREE.Mesh(wingGeoR, wingMat);
  const wingL = new THREE.Mesh(wingGeoR.clone(), wingMat);
  wingL.scale.x = -1;
  const wings = new THREE.Group();
  wings.add(wingR); wings.add(wingL);
  wings.position.set(0, -0.1, 0.8);
  root.add(wings);
  // LERX strakes — thin flat triangle blending each wing root forward along the
  // fuselage. matFuse (grey, no vertexColors) to avoid black-vertex artifacts.
  for (const s of [-1, 1]) {
    const shape = new THREE.Shape();
    shape.moveTo(0, 0);
    shape.lineTo(s * 1.15, 0);
    shape.lineTo(s * 0.30, 3.2);
    shape.closePath();
    const lerxGeo = new THREE.ExtrudeGeometry(shape, { depth: 0.07, bevelEnabled: false });
    const lerx = new THREE.Mesh(lerxGeo, matFuse);
    lerx.rotation.x = Math.PI / 2;          // shape XY -> world XZ (lays flat)
    lerx.position.set(0, 0.0, -0.9);
    root.add(lerx);
  }
>>>
