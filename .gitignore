# Required deploy models are small enough for Git and needed by Netlify builds.
archive/models-unused/
archive/backups/

# Archived screenshots (session captures, not source assets)
archive/screenshots/

# Designer backup (regenerated on first run)
flight-sim3.html.bak

# Temp autopilot screenshots
/tmp/ap-frame.png

# Experiment runtime state — committed per-feature by the world-designer
# (see world-designer.mjs), never part of the baseline.
autopilot-skills.json
world-state.json
feature-requests.json
build-log.json

# Bun
node_modules/

# Generated deploy package
/dist/

# Tool state
.grok/
research/_agent_ids.txt
/.playwright-mcp
/.contex
.gstack/
/.antigravitycli

